# current Module Four Assignment Guidelines and Rubric.

START hilow_game

    # Establish a valid guessing range.
   OUTPUT "Enter the lower bound:"
INPUT lower_bound
OUTPUT "Enter the upper bound:"
INPUT upper_bound
WHILE lower_bound >= upper_bound
    OUTPUT "Lower bound must be less than upper bound."
    OUTPUT "Enter the lower bound:"
    INPUT lower_bound
    OUTPUT "Enter the upper bound:"
    INPUT upper_bound
END WHILE


    # Establish the number the player is trying to guess.
    SECRET_NUMBER = RANDOM(lower_bound, upper_bound)

    # Play the game.
OUTPUT "Enter your guess:"
INPUT guess

WHILE guess < lower_bound OR guess > upper_bound
    OUTPUT "Guess must be between the lower and upper bounds."
    OUTPUT "Enter your guess:"
    INPUT guess
END WHILE


IF guess < secret_number
   OUTPUT "Too low."
ELSE IF guess > secret_number
   OUTPUT "Too high."
END IF
WHILE guess != secret_number
    OUTPUT "Enter your guess:"
    INPUT guess
    WHILE guess < lower_bound OR guess > upper_bound
        OUTPUT "Guess must be between the lower and upper bounds."
        OUTPUT "Enter your guess:"
        INPUT guess
END WHILE

If guess < secret_number
output "Too low."
END IF
END WHILE

OUTPUT "Correct! You guessed the number."
        TODO: Obtain and validate another guess when play continues.

END hilow_game

